---
import "../styles/global.css";

interface Props {
  title: string;
  protected?: boolean; // si true, redirige vers le portail si non "connecte"
}

const { title, protected: isProtected = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href={`${base}/logo.png`} />
    <title>{title} — Archive ALI</title>
  </head>
  <body>
    {
      isProtected && (
        <script define:vars={{ base }} is:inline>
          (function () {
            var ok = window.sessionStorage.getItem("ali_archive_auth") === "true";
            if (!ok) {
              window.location.href = base + "/";
            }
          })();
        </script>
      )
    }

    <header class="site-header">
      <div class="container">
        <a class="logo-link" href={`${base}/home`}>
          <img class="logo" src={`${base}/logo.png`} alt="Africa Leadership Higher Institute" />
          <span class="badge-beta">Beta</span>
        </a>
        {
          isProtected && (
            <nav>
              <a href={`${base}/home`}>Accueil</a>
              <a href={`${base}/cours`}>Cours</a>
            </nav>
          )
        }
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      Archive ALI — version beta interne, donnees de test uniquement.
    </footer>
  </body>
</html>
