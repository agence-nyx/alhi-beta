---
import Layout from "../../layouts/Layout.astro";
import { loadAllCourses } from "../../lib/data.mjs";

const base = import.meta.env.BASE_URL;
const allCourses = loadAllCourses();

// On serialise les cours pour le filtrage cote client (island vanilla JS).
// Passe par define:vars (jamais par une balise <script type="application/json">
// avec interpolation : Astro echappe le HTML et corrompt le JSON).
const coursesData = allCourses.map((c) => ({
  filiere: c.filiere,
  intitule: c.intitule,
  annee: c.annee,
  period: c.period,
  volumeHoraire: c.volumeHoraire,
  hasPdf: c.hasPdf,
  pdfUrl: c.pdfRelPath ? `${base}/data/${encodeURI(c.pdfRelPath)}` : null,
}));
---

<Layout title="Cours" protected={true} navActive="cours" fullBleed={true}>
  <header class="cours-page-head">
    <h1>Section Cours</h1>
    <p>
      Choisis une filière, puis un cours. Les supports sont classés par
      promotion.
    </p>
  </header>

  <div class="container cours-body">
    <div class="wheel-panel">
      <div class="wheel-box">
        <div class="wheel-band"></div>
        <div class="wheel" id="wheel-filiere" role="listbox" tabindex="0" aria-label="Filière"></div>
      </div>
      <div class="wheel-box">
        <div class="wheel-band"></div>
        <div class="wheel" id="wheel-cours" role="listbox" tabindex="0" aria-label="Cours"></div>
      </div>
    </div>

    <div id="cours-results" class="cours-results" aria-live="polite"></div>
  </div>

  <script define:vars={{ coursesData }} is:inline>
    var allCourses = coursesData;
    var resultsEl = document.getElementById("cours-results");
    var reducedMotion =
      window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Une couleur par filiere (dans l'ordre alphabetique), tiree de la
    // palette du site : "c" = couleur pleine, "t" = teinte claire (pastille).
    var PALETTE = [
      { c: "#ad233a", t: "rgba(173, 35, 58, 0.12)" },
      { c: "#1f6f6b", t: "rgba(31, 111, 107, 0.13)" },
      { c: "#a8741a", t: "rgba(168, 116, 26, 0.15)" },
      { c: "#3d4a8a", t: "rgba(61, 74, 138, 0.13)" },
    ];

    // ---- Wheel picker (selecteur a tambour) ---------------------------
    // Une liste verticale a defilement magnetique (scroll-snap) de 3 lignes :
    // l'element au centre, entre les deux traits, est l'element selectionne.
    // Un espaceur CSS d'un element de chaque cote (::before/::after) permet
    // de centrer le premier et le dernier. L'index se deduit de
    // scrollTop / hauteur d'element. Le gras suit le defilement en direct ;
    // le changement n'est valide (onChange) qu'une fois le geste termine.
    // Commandes : molette, doigt, clic sur un element, clavier, glisser souris.
    function createWheel(root, onChange) {
      var options = [];
      var index = 0; // dernier element valide (onChange deja appele)
      var itemH = 50;
      var settleTimer = null;
      var paintQueued = false;
      var drag = null;
      var dragMoved = false;

      function clamp(i) {
        return Math.max(0, Math.min(options.length - 1, i));
      }

      function measure() {
        var first = root.querySelector(".wheel-item");
        if (first && first.offsetHeight) itemH = first.offsetHeight;
      }

      // Met en avant l'element n (gras + couleur pleine).
      function highlight(n) {
        var items = root.children;
        for (var i = 0; i < items.length; i++) {
          items[i].classList.toggle("is-selected", i === n);
          items[i].setAttribute("aria-selected", i === n ? "true" : "false");
        }
        if (items[n]) root.setAttribute("aria-activedescendant", items[n].id);
      }

      function paint() {
        paintQueued = false;
        highlight(clamp(Math.round(root.scrollTop / itemH)));
      }

      function commit(i) {
        i = clamp(i);
        if (i === index || options.length === 0) return;
        index = i;
        highlight(index);
        onChange(options[index].value);
      }

      function goTo(i, smooth) {
        i = clamp(i);
        root.scrollTo({ top: i * itemH, behavior: smooth && !reducedMotion ? "smooth" : "auto" });
        commit(i);
      }

      // Remplace les options ; selectedValue est la valeur a selectionner.
      function setOptions(opts, selectedValue) {
        options = opts;
        root.innerHTML = "";
        opts.forEach(function (o, i) {
          var it = document.createElement("div");
          it.className = "wheel-item";
          it.id = root.id + "-opt-" + i;
          it.setAttribute("role", "option");
          it.setAttribute("data-index", String(i));
          it.textContent = o.label;
          root.appendChild(it);
        });
        measure();
        var idx = 0;
        opts.forEach(function (o, i) {
          if (o.value === selectedValue) idx = i;
        });
        index = idx;
        highlight(idx);
        root.scrollTop = idx * itemH;
      }

      root.addEventListener("scroll", function () {
        if (!paintQueued) {
          paintQueued = true;
          requestAnimationFrame(paint);
        }
        // Une fois le defilement (et l'aimantation) termine, on valide l'element centre.
        clearTimeout(settleTimer);
        settleTimer = setTimeout(function () {
          commit(Math.round(root.scrollTop / itemH));
        }, 90);
      });

      root.addEventListener("click", function (e) {
        var item = e.target.closest ? e.target.closest(".wheel-item") : null;
        if (item) goTo(parseInt(item.getAttribute("data-index"), 10), true);
      });

      root.addEventListener("keydown", function (e) {
        var step = { ArrowDown: 1, ArrowUp: -1, PageDown: 2, PageUp: -2 }[e.key];
        if (step !== undefined) goTo(index + step, true);
        else if (e.key === "Home") goTo(0, true);
        else if (e.key === "End") goTo(options.length - 1, true);
        else return;
        e.preventDefault();
      });

      // Glisser a la souris. L'aimantation est coupee pendant le geste
      // (sinon elle lutte contre le deplacement) puis rendue au relachement.
      root.addEventListener("pointerdown", function (e) {
        if (e.pointerType === "touch" || e.button !== 0) return;
        drag = { y: e.clientY, top: root.scrollTop };
        dragMoved = false;
      });
      window.addEventListener("pointermove", function (e) {
        if (!drag) return;
        var dy = e.clientY - drag.y;
        if (!dragMoved && Math.abs(dy) > 5) {
          dragMoved = true;
          root.style.scrollSnapType = "none";
          root.classList.add("is-dragging");
        }
        if (dragMoved) root.scrollTop = drag.top - dy;
      });
      window.addEventListener("pointerup", function () {
        if (!drag) return;
        drag = null;
        if (dragMoved) {
          root.classList.remove("is-dragging");
          root.style.scrollSnapType = "";
          goTo(Math.round(root.scrollTop / itemH), true);
        }
      });
      // Un glisser ne doit pas etre pris pour un clic sur un element.
      root.addEventListener(
        "click",
        function (e) {
          if (dragMoved) {
            e.stopPropagation();
            dragMoved = false;
          }
        },
        true
      );

      return {
        setOptions: setOptions,
        select: function (i) {
          goTo(i, true);
        },
      };
    }

    // ---- Donnees -------------------------------------------------------
    function unique(list) {
      return list.filter(function (v, i) {
        return list.indexOf(v) === i;
      });
    }

    // [{ name, courses: [...] }] : une entree par filiere, ses cours tries par
    // intitule puis par promo (la plus recente d'abord). Un meme cours donne
    // par plusieurs promos garde une carte par promo ; sa roue ajoute alors
    // la promo au libelle pour les distinguer.
    function buildModel() {
      var names = unique(allCourses.map(function (c) { return c.filiere; })).sort(function (a, b) {
        return a.localeCompare(b, "fr");
      });
      return names.map(function (name) {
        var list = allCourses
          .filter(function (c) { return c.filiere === name; })
          .sort(function (a, b) {
            return (
              a.intitule.localeCompare(b.intitule, "fr") ||
              String(b.period).localeCompare(String(a.period))
            );
          });
        var counts = {};
        list.forEach(function (c) { counts[c.intitule] = (counts[c.intitule] || 0) + 1; });
        list.forEach(function (c) {
          c.label = counts[c.intitule] > 1 ? c.intitule + " · " + c.period : c.intitule;
        });
        return { name: name, courses: list };
      });
    }

    // ---- Rendu ---------------------------------------------------------
    function text(tag, cls, str) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      e.textContent = str;
      return e;
    }

    // <span>avant <b>valeur</b> apres</span>, construit par le DOM.
    function metaItem(before, strong, after) {
      var s = document.createElement("span");
      if (before) s.appendChild(document.createTextNode(before));
      var b = document.createElement("b");
      b.textContent = strong;
      s.appendChild(b);
      if (after) s.appendChild(document.createTextNode(after));
      return s;
    }

    var model = buildModel();
    var f = 0; // filiere selectionnee
    var c = 0; // cours selectionne dans cette filiere

    function renderCards() {
      var color = PALETTE[f % PALETTE.length];
      resultsEl.innerHTML = "";
      // Construction par le DOM (textContent) : un nom de cours contenant
      // "<" ou "&" ne peut pas casser la page.
      model[f].courses.forEach(function (course, i) {
        var card = document.createElement("article");
        card.className = "cours-card" + (i === c ? " sel" : "");
        card.setAttribute("data-i", String(i));
        card.style.setProperty("--c", color.c);
        card.style.setProperty("--t", color.t);

        card.appendChild(text("span", "cours-chip", model[f].name));

        var body = document.createElement("div");
        body.appendChild(text("span", "cours-card-title", course.intitule));
        var meta = document.createElement("div");
        meta.className = "cours-card-meta";
        meta.appendChild(metaItem("Année ", String(course.annee), ""));
        meta.appendChild(metaItem("Promo ", String(course.period), ""));
        if (course.volumeHoraire) meta.appendChild(metaItem("", String(course.volumeHoraire), " h"));
        body.appendChild(meta);

        if (course.hasPdf && course.pdfUrl) {
          var link = text("a", "cours-card-link", "Voir le support →");
          link.href = course.pdfUrl;
          link.target = "_blank";
          link.rel = "noopener";
          body.appendChild(link);
        } else {
          body.appendChild(text("span", "cours-card-link is-off", "PDF indisponible"));
        }
        card.appendChild(body);
        resultsEl.appendChild(card);
      });
    }

    // Met en avant la carte du cours choisi dans la roue.
    function markSelected() {
      var cards = resultsEl.children;
      for (var i = 0; i < cards.length; i++) cards[i].classList.toggle("sel", i === c);
    }

    function setCoursOptions() {
      coursWheel.setOptions(
        model[f].courses.map(function (course, i) { return { value: i, label: course.label }; }),
        0
      );
    }

    var coursWheel = createWheel(document.getElementById("wheel-cours"), function (i) {
      c = i;
      markSelected();
    });
    var filiereWheel = createWheel(document.getElementById("wheel-filiere"), function (i) {
      if (i === f) return;
      f = i;
      c = 0;
      setCoursOptions();
      renderCards();
    });

    // Cliquer une carte amene la roue "Cours" sur ce cours (hors lien PDF).
    resultsEl.addEventListener("click", function (e) {
      if (e.target.closest("a")) return;
      var card = e.target.closest(".cours-card");
      if (card) coursWheel.select(parseInt(card.getAttribute("data-i"), 10));
    });

    if (model.length === 0) {
      resultsEl.appendChild(text("p", "cours-empty", "Aucun cours n'est encore archivé."));
    } else {
      filiereWheel.setOptions(
        model.map(function (m, i) { return { value: i, label: m.name }; }),
        0
      );
      setCoursOptions();
      renderCards();
    }
  </script>
</Layout>
