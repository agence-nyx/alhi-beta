---
import Layout from "../layouts/Layout.astro";
import { loadPeriods, loadPeriodData } from "../lib/data.mjs";

const base = import.meta.env.BASE_URL;

const periods = loadPeriods().slice().reverse();
const periodsData = periods.map((period) => {
  const data = loadPeriodData(period);
  return {
    period,
    admins: data.admins,
    filiereGroups: data.filiereGroups.map((g) => ({
      filiere: g.filiere,
      students: g.students.map((s) => ({
        Nom: s.Nom,
        Prenom: s.Prenom,
        Description: s.Description,
        photoUrl: s.photoPath ? `${base}/data/${encodeURI(s.photoPath)}` : null,
      })),
    })),
  };
});
---

<Layout title="Frise chronologique" protected={true} navActive="frise">
  <div class="frise-page-head">
    <p class="eyebrow-mono">Mémorial académique</p>
    <h1>Frise chronologique des promotions</h1>
    <p>Clique sur une branche pour l'ouvrir : année, puis étudiants ou direction, puis filière et personnes.</p>
  </div>

  <div class="tree-wrap" id="tree-wrap">
    <svg id="tree-lines" class="tree-lines"></svg>
    <div class="tree-root" id="tree-root"></div>
  </div>

  <script define:vars={{ periodsData }} is:inline>
    var DATA = periodsData;
    var wrap = document.getElementById("tree-wrap");
    var svg = document.getElementById("tree-lines");
    var rootEl = document.getElementById("tree-root");

    function el(tag, cls) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      return e;
    }

    // ---- Modele de l'arbre -------------------------------------------
    // Chaque noeud est un objet { el, pill, row, kids, open } :
    //   el   : l'element a inserer dans le DOM (colonne pill + rangee)
    //   pill : l'element dont on mesure la position pour tracer les traits
    //   row  : la rangee qui contient les enfants (null pour une personne)
    //   kids : la liste EXPLICITE des noeuds enfants
    // Les traits sont tires de cette liste, jamais deduits de la forme du
    // DOM : une rangee de plus ou de moins dans le HTML ne peut plus
    // casser les liens (c'etait la cause du bug "un seul trait pour deux
    // filieres", un div.tree-row s'etait glisse entre parent et enfants).

    function addKid(node, kid) {
      node.row.appendChild(kid.el);
      node.kids.push(kid);
    }

    // Branche generique : une pill cliquable + une rangee d'enfants
    // construite paresseusement au premier clic par fill(node).
    function buildBranch(pillClass, label, fill) {
      var col = el("div", "tree-col");
      var pill = el("div", "tree-pill " + pillClass);
      pill.textContent = label;
      var row = el("div", "tree-row collapsed");
      col.appendChild(pill);
      col.appendChild(row);

      var node = { el: col, pill: pill, row: row, kids: [], open: false };
      var built = false;
      pill.addEventListener("click", function (e) {
        e.stopPropagation();
        if (!built) {
          fill(node);
          built = true;
        }
        toggleBranch(node);
      });
      return node;
    }

    function buildPersonNode(name, sub, photoUrl) {
      var card = el("div", "tree-person");
      if (photoUrl) {
        var img = document.createElement("img");
        img.src = photoUrl;
        img.alt = name;
        card.appendChild(img);
      } else {
        var initials = el("div", "tree-person-avatar");
        initials.textContent = name.split(" ").map(function (p) { return p[0]; }).join("").slice(0, 2);
        card.appendChild(initials);
      }
      var nameEl = el("div", "tree-person-name");
      nameEl.textContent = name;
      var subEl = el("div", "tree-person-sub");
      subEl.textContent = sub || "";
      card.appendChild(nameEl);
      card.appendChild(subEl);
      return { el: card, pill: card, row: null, kids: [], open: false };
    }

    function buildFiliereNode(group) {
      return buildBranch("tree-pill-filiere", group.filiere, function (node) {
        group.students.forEach(function (s) {
          addKid(node, buildPersonNode(s.Prenom + " " + s.Nom, s.Description, s.photoUrl));
        });
      });
    }

    function buildPeriodNode(periodData) {
      return buildBranch("tree-pill-period", periodData.period, function (node) {
        addKid(node, buildBranch("tree-pill-cat", "Étudiants", function (cat) {
          periodData.filiereGroups.forEach(function (g) {
            addKid(cat, buildFiliereNode(g));
          });
        }));
        addKid(node, buildBranch("tree-pill-cat", "Direction", function (cat) {
          periodData.admins.forEach(function (a) {
            addKid(cat, buildPersonNode(a.Prenom + " " + a.Nom, a.Poste));
          });
        }));
      });
    }

    // Racine : toujours ouverte, ses enfants sont les annees.
    var rootNode = (function () {
      var col = el("div", "tree-col");
      var pill = el("div", "tree-pill tree-pill-root");
      pill.textContent = "Archive ALI";
      var row = el("div", "tree-row");
      col.appendChild(pill);
      col.appendChild(row);
      var node = { el: col, pill: pill, row: row, kids: [], open: true };
      DATA.forEach(function (periodData) {
        addKid(node, buildPeriodNode(periodData));
      });
      return node;
    })();

    // Ouvre/ferme une branche. Au repli, la rangee n'est retiree du flux
    // (display:none) qu'une fois l'animation finie, sinon elle garde sa
    // place et les branches voisines ne reviennent pas a leur position.
    function toggleBranch(node) {
      var row = node.row;
      var opening = !node.open;
      node.open = opening;
      if (opening) {
        row.style.display = "flex";
        void row.offsetWidth;
        row.classList.remove("collapsed");
      } else {
        row.classList.add("collapsed");
        setTimeout(function () {
          if (row.classList.contains("collapsed")) row.style.display = "none";
        }, 420);
      }
      node.pill.classList.toggle("is-open", opening);
      animateLines(500);
    }

    // Redessine les traits a chaque frame pendant la transition CSS pour
    // qu'ils suivent l'ouverture/fermeture.
    var animUntil = 0;
    var animRunning = false;
    function animateLines(duration) {
      animUntil = Math.max(animUntil, performance.now() + duration);
      if (animRunning) return;
      animRunning = true;
      function step(now) {
        drawLines();
        if (now < animUntil) {
          requestAnimationFrame(step);
        } else {
          animRunning = false;
          drawLines(); // trace final une fois la mise en page stabilisee
        }
      }
      requestAnimationFrame(step);
    }

    // Un element sans rectangle est dans un display:none : le mesurer
    // renverrait des zeros et le trait partirait du coin de la fenetre.
    function isHidden(node) {
      return node.getClientRects().length === 0;
    }

    function drawLines() {
      var wrapRect = wrap.getBoundingClientRect();
      // Le SVG est en absolu DANS .tree-wrap (overflow-x:auto) : il defile
      // avec le contenu. Les coordonnees doivent donc etre relatives au
      // contenu, d'ou scrollLeft/scrollTop.
      var offX = wrap.scrollLeft - wrapRect.left;
      var offY = wrap.scrollTop - wrapRect.top;
      svg.setAttribute("width", wrap.scrollWidth);
      svg.setAttribute("height", wrap.scrollHeight);
      svg.innerHTML = "";

      function draw(node) {
        if (!node.open || isHidden(node.pill)) return;
        var pRect = node.pill.getBoundingClientRect();
        var startX = pRect.left + pRect.width / 2 + offX;
        var startY = pRect.bottom + offY;

        node.kids.forEach(function (kid) {
          if (isHidden(kid.pill)) return;
          var cRect = kid.pill.getBoundingClientRect();
          var endX = cRect.left + cRect.width / 2 + offX;
          var endY = cRect.top + offY;
          var midY = (startY + endY) / 2;
          var path = document.createElementNS("http://www.w3.org/2000/svg", "path");
          path.setAttribute(
            "d",
            "M" + startX + "," + startY + " C " + startX + "," + midY + " " + endX + "," + midY + " " + endX + "," + endY
          );
          path.setAttribute("class", "tree-line");
          svg.appendChild(path);
          draw(kid);
        });
      }
      draw(rootNode);
    }

    rootEl.appendChild(rootNode.el);
    drawLines();
    window.addEventListener("resize", drawLines);
    // Les photos se chargent apres l'ouverture d'une branche et changent la
    // hauteur des cartes : on retrace quand la taille du contenu change.
    if (window.ResizeObserver) {
      new ResizeObserver(function () { drawLines(); }).observe(rootEl);
    }
    rootEl.addEventListener("load", function () { drawLines(); }, true);
  </script>
</Layout>
