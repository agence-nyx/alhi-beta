---
import Layout from "../layouts/Layout.astro";
import { loadPeriods, loadPeriodData } from "../lib/data.mjs";

const base = import.meta.env.BASE_URL;

const periods = loadPeriods().slice().reverse();
const periodsData = periods.map((period) => {
  const data = loadPeriodData(period);
  return {
    period,
    admins: data.admins,
    filiereGroups: data.filiereGroups.map((g) => ({
      filiere: g.filiere,
      students: g.students.map((s) => ({
        Nom: s.Nom,
        Prenom: s.Prenom,
        Description: s.Description,
        photoUrl: s.photoPath ? `${base}/data/${encodeURI(s.photoPath)}` : null,
      })),
    })),
  };
});
---

<Layout title="Frise chronologique" protected={true} navActive="frise">
  <div class="frise-page-head">
    <p class="eyebrow-mono">Mémorial académique</p>
    <h1>Frise chronologique des promotions</h1>
    <p>Clique sur une branche pour l'ouvrir : année, puis étudiants ou direction, puis filière et personnes.</p>
  </div>

  <div class="tree-wrap" id="tree-wrap">
    <svg id="tree-lines" class="tree-lines"></svg>
    <div class="tree-root" id="tree-root"></div>
  </div>

  <script define:vars={{ periodsData }} is:inline>
    var DATA = periodsData;
    var wrap = document.getElementById("tree-wrap");
    var svg = document.getElementById("tree-lines");
    var rootEl = document.getElementById("tree-root");

    function el(tag, cls) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      return e;
    }

    // Ouvre/ferme une branche : au repli, la largeur n'est liberee qu'une
    // fois l'animation terminee (display:none), sinon la rangee garde sa
    // place dans le flex et les branches voisines ne reviennent jamais a
    // leur position d'origine.
    function toggleRow(row, pill) {
      var opening = row.classList.contains("collapsed");
      if (opening) {
        row.style.display = "flex";
        void row.offsetWidth;
        row.classList.remove("collapsed");
      } else {
        row.classList.add("collapsed");
        setTimeout(function () {
          if (row.classList.contains("collapsed")) row.style.display = "none";
        }, 420);
      }
      pill.classList.toggle("is-open", opening);
      animateLines(500);
    }

    // Redessine les traits a chaque frame pendant la duree de la
    // transition CSS, pour qu'ils suivent l'ouverture/fermeture au lieu
    // de sauter a un instant fixe qui peut tomber au mauvais moment.
    var animUntil = 0;
    var animRunning = false;
    function animateLines(duration) {
      animUntil = Math.max(animUntil, performance.now() + duration);
      if (animRunning) return;
      animRunning = true;
      function step(now) {
        drawLines();
        if (now < animUntil) {
          requestAnimationFrame(step);
        } else {
          animRunning = false;
        }
      }
      requestAnimationFrame(step);
    }

    function buildTree() {
      var root = buildPeriodLevel();
      rootEl.innerHTML = "";
      rootEl.appendChild(root);
      drawLines();
    }

    function buildPeriodLevel() {
      var col = el("div", "tree-col");
      var pill = el("div", "tree-pill tree-pill-root");
      pill.textContent = "Archive ALI";
      col.appendChild(pill);

      var row = el("div", "tree-row");
      DATA.forEach(function (periodData) {
        row.appendChild(buildPeriodNode(periodData));
      });
      col.appendChild(row);
      return col;
    }

    function buildPeriodNode(periodData) {
      var col = el("div", "tree-col");
      var pill = el("div", "tree-pill tree-pill-period");
      pill.textContent = periodData.period;
      col.appendChild(pill);

      var row = el("div", "tree-row collapsed");
      var built = false;

      pill.addEventListener("click", function () {
        if (!built) {
          row.appendChild(buildCategoryNode("Étudiants", "cat", function (catCol) {
            var r = el("div", "tree-row");
            periodData.filiereGroups.forEach(function (g) {
              r.appendChild(buildFiliereNode(g));
            });
            return r;
          }));
          row.appendChild(buildCategoryNode("Direction", "cat", function (catCol) {
            var r = el("div", "tree-row");
            periodData.admins.forEach(function (a) {
              r.appendChild(buildPersonCard(a.Prenom + " " + a.Nom, a.Poste));
            });
            return r;
          }));
          built = true;
        }
        toggleRow(row, pill);
      });

      col.appendChild(row);
      return col;
    }

    function buildCategoryNode(label, kind, makeChildrenRow) {
      var col = el("div", "tree-col");
      var pill = el("div", "tree-pill tree-pill-cat");
      pill.textContent = label;
      col.appendChild(pill);

      var row = el("div", "tree-row collapsed");
      var built = false;

      pill.addEventListener("click", function (e) {
        e.stopPropagation();
        if (!built) {
          row.appendChild(makeChildrenRow(col));
          built = true;
        }
        toggleRow(row, pill);
      });

      col.appendChild(row);
      return col;
    }

    function buildFiliereNode(group) {
      var col = el("div", "tree-col");
      var pill = el("div", "tree-pill tree-pill-filiere");
      pill.textContent = group.filiere;
      col.appendChild(pill);

      var row = el("div", "tree-row collapsed");
      var built = false;

      pill.addEventListener("click", function (e) {
        e.stopPropagation();
        if (!built) {
          group.students.forEach(function (s) {
            row.appendChild(buildPersonCard(s.Prenom + " " + s.Nom, s.Description, s.photoUrl));
          });
          built = true;
        }
        toggleRow(row, pill);
      });

      col.appendChild(row);
      return col;
    }

    function buildPersonCard(name, sub, photoUrl) {
      var card = el("div", "tree-person");
      if (photoUrl) {
        var img = document.createElement("img");
        img.src = photoUrl;
        img.alt = name;
        card.appendChild(img);
      } else {
        var initials = el("div", "tree-person-avatar");
        initials.textContent = name.split(" ").map(function (p) { return p[0]; }).join("").slice(0, 2);
        card.appendChild(initials);
      }
      var nameEl = el("div", "tree-person-name");
      nameEl.textContent = name;
      var subEl = el("div", "tree-person-sub");
      subEl.textContent = sub || "";
      card.appendChild(nameEl);
      card.appendChild(subEl);
      return card;
    }

    function drawLines() {
      var wrapRect = wrap.getBoundingClientRect();
      svg.setAttribute("width", wrapRect.width);
      svg.setAttribute("height", wrapRect.height);
      svg.innerHTML = "";

      document.querySelectorAll(".tree-col").forEach(function (col) {
        var pill = col.querySelector(":scope > .tree-pill, :scope > .tree-person");
        var row = col.querySelector(":scope > .tree-row");
        if (!pill || !row || row.classList.contains("collapsed")) return;

        var pRect = pill.getBoundingClientRect();
        var startX = pRect.left + pRect.width / 2 - wrapRect.left;
        var startY = pRect.bottom - wrapRect.top;

        Array.prototype.forEach.call(row.children, function (childCol) {
          var childPill = childCol.querySelector(":scope > .tree-pill, :scope > .tree-person") || childCol;
          var cRect = childPill.getBoundingClientRect();
          var endX = cRect.left + cRect.width / 2 - wrapRect.left;
          var endY = cRect.top - wrapRect.top;
          var midY = (startY + endY) / 2;

          var path = document.createElementNS("http://www.w3.org/2000/svg", "path");
          path.setAttribute(
            "d",
            "M" + startX + "," + startY + " C " + startX + "," + midY + " " + endX + "," + midY + " " + endX + "," + endY
          );
          path.setAttribute("class", "tree-line");
          svg.appendChild(path);
        });
      });
    }

    buildTree();
    window.addEventListener("resize", drawLines);
  </script>
</Layout>
