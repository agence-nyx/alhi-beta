---
import Layout from "../layouts/Layout.astro";
import { loadPeriods, loadPeriodData } from "../lib/data.mjs";

const base = import.meta.env.BASE_URL;

const periods = loadPeriods().slice().reverse(); // plus recent en premier
const periodsData = periods.map((period) => {
  const data = loadPeriodData(period);
  return {
    period,
    admins: data.admins,
    filiereGroups: data.filiereGroups.map((g) => ({
      filiere: g.filiere,
      students: g.students.map((s) => ({
        Nom: s.Nom,
        Prenom: s.Prenom,
        Description: s.Description,
        photoUrl: s.photoPath ? `${base}/data/${encodeURI(s.photoPath)}` : null,
      })),
    })),
  };
});

---

<Layout title="Frise chronologique" protected={true} navActive="frise">
  <div class="frise-page-head">
    <p class="eyebrow-mono">Mémorial académique</p>
    <h1>Frise chronologique des promotions</h1>
    <p>Choisis une année, puis étudiants ou direction, pour découvrir la promotion correspondante.</p>
  </div>

  <div class="frise-col" id="frise-col"></div>

  <script define:vars={{ base, periodsData }} is:inline>
    var PERIODS = periodsData;
    var col = document.getElementById("frise-col");
    var rowH = 40;
    var visibleRows = 3;

    function el(tag, cls, text) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    }

    function waitFrame() {
      return new Promise(function (r) { requestAnimationFrame(r); });
    }
    function sleep(ms) {
      return new Promise(function (r) { setTimeout(r, ms); });
    }

    // Affiche un picker a defilement pour `options` (tableau de libelles).
    // Resout avec l'index choisi quand l'utilisateur clique ou valide au clavier.
    function runPicker(options) {
      return new Promise(function (resolve) {
        var frame = el("div", "frise-picker-frame");
        frame.style.height = rowH * visibleRows + "px";
        var focus = el("div", "frise-picker-focus");
        focus.style.top = rowH + "px";
        focus.style.height = rowH + "px";
        var inner = el("div", "frise-picker-inner");
        inner.style.transform = "translateY(" + rowH + "px)";

        options.forEach(function (label, idx) {
          var row = el("div", "frise-picker-row is-center", label);
          row.style.height = rowH + "px";
          row.tabIndex = 0;
          row.setAttribute("role", "option");
          row.addEventListener("click", function () { choose(idx); });
          row.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); choose(idx); }
          });
          inner.appendChild(row);
        });

        frame.appendChild(inner);
        frame.appendChild(focus);
        col.appendChild(frame);

        var chosen = false;
        function choose(idx) {
          if (chosen) return;
          chosen = true;
          var target = inner.children[idx];
          focus.style.background = "var(--color-bg)";
          target.classList.add("is-selected");
          resolve({ index: idx, value: options[idx], frame: frame, target: target });
        }
      });
    }

    // Anime la montee du texte choisi vers le fil, puis trace le connecteur.
    async function resolveIntoTrail(picked) {
      await sleep(250);
      var oldRect = picked.target.getBoundingClientRect();
      picked.frame.remove();

      var line = el("div", "frise-resolved", picked.value);
      col.appendChild(line);
      var newRect = line.getBoundingClientRect();
      var dx = oldRect.left - newRect.left;
      var dy = oldRect.top - newRect.top;
      line.style.transform = "translate(" + dx + "px," + dy + "px) scale(1.15)";
      line.style.transition = "none";
      void line.offsetWidth;
      line.style.transition = "transform .5s cubic-bezier(.22,.8,.25,1)";
      await waitFrame();
      line.style.transform = "none";
      await sleep(550);

      var connector = el("div", "frise-connector");
      connector.style.height = "0px";
      col.appendChild(connector);
      await sleep(30);
      connector.style.height = "20px";
      await sleep(480);
    }

    function studentCard(s) {
      var card = el("div", "frise-profile-card");
      var img = document.createElement("img");
      img.src = s.photoUrl || "";
      img.alt = s.Prenom + " " + s.Nom;
      card.appendChild(img);
      card.appendChild(el("div", "name", s.Prenom + " " + s.Nom));
      card.appendChild(el("div", "sub", s.Description || ""));
      return card;
    }

    function adminCard(a) {
      var card = el("div", "frise-profile-card");
      var initials = el("div", "name", a.Prenom + " " + a.Nom);
      card.appendChild(initials);
      card.appendChild(el("div", "sub", a.Poste));
      return card;
    }

    async function showCards(items, renderFn, emptyLabel) {
      if (items.length === 0) {
        col.appendChild(el("p", "frise-empty", emptyLabel));
        return;
      }
      var fan = el("div", "frise-cards");
      col.appendChild(fan);
      for (var i = 0; i < items.length; i++) {
        var c = renderFn(items[i]);
        fan.appendChild(c);
        await sleep(90);
        (function (node) {
          requestAnimationFrame(function () { node.classList.add("in"); });
        })(c);
      }
    }

    function addRestart() {
      var again = el("a", "btn-pill btn-pill-secondary", "Recommencer");
      again.href = "#";
      again.style.marginTop = "2rem";
      again.addEventListener("click", function (e) {
        e.preventDefault();
        run();
      });
      col.appendChild(again);
    }

    async function run() {
      col.innerHTML = "";

      var yearOptions = PERIODS.map(function (p) { return p.period; });
      var yearPick = await runPicker(yearOptions);
      await resolveIntoTrail(yearPick);
      var periodData = PERIODS[yearPick.index];

      var typePick = await runPicker(["Étudiants", "Direction"]);
      await resolveIntoTrail(typePick);

      if (typePick.index === 0) {
        var filiereOptions = periodData.filiereGroups.map(function (g) { return g.filiere; });
        var filierePick = await runPicker(filiereOptions);
        await resolveIntoTrail(filierePick);
        var group = periodData.filiereGroups[filierePick.index];
        await showCards(group.students, studentCard, "Aucun étudiant enregistré pour cette filière.");
      } else {
        await showCards(periodData.admins, adminCard, "Aucun membre de l'équipe enregistré pour cette promotion.");
      }

      addRestart();
    }

    run();
  </script>
</Layout>
